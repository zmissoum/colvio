{
  "manifest_version": 3,
  "name": "Colvio for Dynamics 365",
  "version": "1.11.199",
  "description": "Colvio \u2014 Data Explorer, Loader & Inspector for Microsoft Dynamics 365 / Dataverse.",
  "author": "zmissoum",
  "minimum_chrome_version": "110",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "declarativeContent",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://*.dynamics.com/*",
    "https://*.microsoftdynamics.us/*",
    "https://*.dynamics.cn/*"
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; worker-src blob:"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dynamics.com/*",
        "https://*.microsoftdynamics.us/*",
        "https://*.dynamics.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Colvio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}